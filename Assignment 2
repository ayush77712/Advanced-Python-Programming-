def border(func):
    def wrapper(self):
        return "*" * 30 + "\n" + func(self) + "\n" + "*" * 30
    return wrapper

def uppercase(func):
    def wrapper(self):
        return func(self).upper()
    return wrapper

def footer(func):
    def wrapper(self):
        return func(self) + "\nEnd of Report"
    return wrapper

class Report:
    template = "General Report"

    def __init__(self, title, author, date, content):
        self.title = title
        self.author = author
        self.date = date
        self.content = content

    @classmethod
    def set_template(cls, t):
        cls.template = t

    @border
    @uppercase
    @footer
    def generate(self):
        return f"""Template : {Report.template}
Title : {self.title}
Author : {self.author}
Date : {self.date}
Content : {self.content}"""

    def __str__(self):
        return self.title

    def __len__(self):
        return len(self.content)

    def __eq__(self, other):
        return self.title == other.title

    def __add__(self, other):
        return self.content + "\n" + other.content

